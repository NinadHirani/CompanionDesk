{
  "name": "companiondesk",
  "version": "0.1.0",
  "description": "CompanionDesk: a free, local-first student assistant that learns how you work. No billing, no accounts, no cloud requirement.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test tests/*.test.js && npm run test:benchmark",
    "dist:mac": "electron-builder --mac --publish never",
    "pack": "electron-builder --dir --publish never",
    "build:web": "bash scripts/build-web.sh",
    "dist": "node scripts/build-dist.js",
    "test:benchmark": "bash experiments/android-inference-benchmark/scripts/selftest.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdfjs-dist": "^6.4.299",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.companiondesk.assistant",
    "productName": "CompanionDesk",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "prompts/**/*",
      "build/icon.png",
      "PRIVACY_POLICY.md",
      "TERMS.md",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CompanionDesk uses the microphone only when you press Speak in the overlay. Your voice is turned into text on this computer and is never sent anywhere."
      }
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CompanionDesk-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NinadHirani",
        "repo": "CompanionDesk"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CompanionDesk-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "CompanionDesk-${version}-${arch}.${ext}",
      "title": "CompanionDesk ${version}"
    }
  },
  "author": "Ninad Hirani"
}
