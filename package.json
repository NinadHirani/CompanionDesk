{
  "name": "companiondesk",
  "version": "0.1.0",
  "description": "CompanionDesk: free-first, local-models student assistant + desktop companion (NUS-style). No billing, no accounts, no cloud requirement.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test tests/*.test.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.companiondesk.assistant",
    "productName": "CompanionDesk",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "prompts/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
